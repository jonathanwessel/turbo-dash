{
  "name": "turbo-dash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5184 --strictPort",
    "build": "vite build",
    "play": "vite preview --host --outDir live --port 5183 --strictPort",
    "release": "node scripts/release.mjs",
    "stage": "vite build --outDir .staging --emptyOutDir && vite preview --host --outDir .staging --port 5185 --strictPort"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  }
}
